PP_ENV=local
HTTP_ADDR=:8080
CORE_DB_DSN=
# Defaults to CORE_DB_DSN when empty (single Postgres, both migrations applied).
ANALYSIS_DB_DSN=
# S3-compatible object storage (MinIO in docker compose).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docsapp
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=docsapp
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Postgres (внутри docker сети)
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_SSLMODE=disable

# To avoid root-owned files on bind mounts
UID=$(id -u)
GID=$(id -g)
