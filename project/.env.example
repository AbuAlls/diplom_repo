PP_ENV=local
HTTP_ADDR=:8080
CORE_DB_DSN=
# Defaults to CORE_DB_DSN when empty (single Postgres, both migrations applied).
ANALYSIS_DB_DSN=
# S3-compatible object storage (MinIO in docker compose).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docsapp
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=docsapp
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# AI analytics service (business-audit-analytics) integration.
# RECOGNIZER=mock (default) keeps the deterministic stub; "audit" calls the real service.
RECOGNIZER=mock
AI_SERVICE_URL=http://localhost:8000
AI_MODEL=yc:qwen3.5-35b-a3b
AI_REQUEST_TIMEOUT=60s
# Shared secret the AI agent must send as X-Internal-Token on /api/* callbacks.
# Set the same value as the AI service's expectation; keep it out of source control.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# Postgres (внутри docker сети)
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_SSLMODE=disable

# To avoid root-owned files on bind mounts
UID=$(id -u)
GID=$(id -g)
