# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in REAL secrets:  cp .env.prod.example .env.prod
# .env.prod must NOT be committed (add it to .gitignore).

# --- Public address / TLS (read by the caddy service) ---
# Empty            -> Caddy serves plain HTTP on :80 (use behind a tunnel, or for
#                     a local prod simulation: curl http://localhost/healthz).
# api.example.com  -> Caddy serves HTTPS and auto-provisions a Let's Encrypt cert.
#                     Requires DNS A-record -> this host and ports 80+443 open.
SITE_ADDRESS=:80

# --- API server (internal bind; Caddy proxies to api:8080) ---
HTTP_ADDR=:8080

# CORS: "*" is safe because auth is an Authorization: Bearer header, not cookies.
# If you add a browser frontend on a fixed origin and want to lock it down, set
# e.g. CORS_ALLOWED_ORIGIN=https://app.example.com
CORS_ALLOWED_ORIGIN=*

# --- Secrets: CHANGE THESE before any real deployment ---
JWT_SECRET=0888942566d8cebc476d01843fec817bb78f439c65c7b578d489aeae1a4e11d6
JWT_ISSUER=docsapp
INTERNAL_API_TOKEN=993879b25328d0e8d6fe82d59766be2f
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Postgres (internal; not published to the host in prod) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=localdevpass
DB_SSLMODE=disable
# Leave DSNs empty to build them from DB_* above.
CORE_DB_DSN=
ANALYSIS_DB_DSN=

# --- MinIO / S3 (internal; downloads stream through the API) ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docsapp
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=localdevsecret

# --- AI analytics integration ---
# mock = deterministic stub (no external service). "audit" calls the real service.
RECOGNIZER=mock
AI_SERVICE_URL=http://localhost:8000
AI_MODEL=yc:qwen3.5-35b-a3b
AI_REQUEST_TIMEOUT=60s

# Recognition queue: db (default, durable) | inproc (example) | sync (inline)
RECOGNITION_QUEUE=db
